// The live graph: Mbit/s per second, one bar per second (two side by side when both ways run),
// a labelled y scale, the seconds under it. Rust draws the bars in pixels of the plot.

import { Theme, Type } from "@vibeware";
import { ChartInfo } from "types.slint";

component Plot inherits Rectangle {
    in property <ChartInfo> c;
    callback resized(length, length);
    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
    init => { root.resized(self.width, self.height); }
    accessible-role: none;
    for layer[i] in [root.c.grid, root.c.up, root.c.down]: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: layer;
        fill: i == 0 ? Theme.line : i == 1 ? Theme.accent : Theme.ink-2;
    }
}

component Label inherits Text {
    font-family: Type.mono;
    font-size: Type.small;
    color: Theme.ink-3;
    accessible-role: none;
}

component Swatch inherits Rectangle {
    width: 8px;
    height: 8px;
    accessible-role: none;
}

export component Chart inherits Rectangle {
    in property <ChartInfo> c;
    callback resized(length, length);
    accessible-role: image;
    accessible-label: "Throughput per second";
    accessible-description: root.c.a11y;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 4px;
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            // The y scale's labels, at their gridlines.
            Rectangle {
                width: 76px;
                Label {
                    x: 0;
                    y: root.c.y-top-at - 8px;
                    width: parent.width;
                    height: 16px;
                    text: root.c.y-top;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Label {
                    x: 0;
                    y: root.c.y-mid-at - 8px;
                    width: parent.width;
                    height: 16px;
                    text: root.c.y-mid;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Plot {
                    vertical-stretch: 1;
                    c: root.c;
                    resized(w, h) => { root.resized(w, h); }
                    if root.c.empty != "": Label {
                        width: 100%;
                        height: 100%;
                        text: root.c.empty;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    height: 16px;
                    Label { text: root.c.x-left; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Label { text: root.c.x-right; vertical-alignment: center; }
                }
            }
        }
        // The legend: what the bars are.
        HorizontalLayout {
            height: 16px;
            padding-left: 82px;
            spacing: 6px;
            alignment: start;
            if root.c.legend-up != "": VerticalLayout {
                alignment: center;
                Swatch { background: Theme.accent; }
            }
            if root.c.legend-up != "": Label { text: root.c.legend-up; vertical-alignment: center; }
            if root.c.legend-down != "": Rectangle { width: 10px; }
            if root.c.legend-down != "": VerticalLayout {
                alignment: center;
                Swatch { background: Theme.ink-2; }
            }
            if root.c.legend-down != "": Label { text: root.c.legend-down; vertical-alignment: center; }
        }
    }
}
